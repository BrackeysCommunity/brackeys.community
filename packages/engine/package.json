  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.5"
  },
  "peerDependencies": {
    "@dimforge/rapier2d": "^0.19.3",
    "@dimforge/rapier2d-compat": "^0.19.3",
    "@hocuspocus/provider": "^4.7.0",
    "@hocuspocus/server": "^4.7.0",
    "@tanstack/store": ">=0.8.1 <0.9.0",
    "fractional-indexing": "^4.0.0",
    "pixi.js": "^8.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yjs": "^13.6.33",
    "zod": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier2d-compat": {
      "optional": true
    },
    "@hocuspocus/provider": {
      "optional": true
    },
    "@hocuspocus/server": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
