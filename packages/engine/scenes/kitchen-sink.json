{
  "$schema": "../scene/scene.schema.json",
  "v": 5,
  "name": "kitchen-sink",
  "bounds": [0, 0, 36, 12],
  "settings": { "camera": { "damping": 0.2 }, "gravity": [0, 12] },
  "assets": ["cards"],
  "instances": [
    { "id": "post-1", "prefab": "post", "at": [16.4, 11.6] },
    { "id": "post-2", "prefab": "post", "at": [17.6, 11.6], "params": { "mark": "peak" } },
    { "id": "gate-1", "prefab": "gate", "at": [19.8, 11.6] },
    { "id": "gate-2", "prefab": "gate", "at": [22, 11.6], "overrides": { "bar.oneWay": true } },
    { "id": "room-1", "prefab": "room", "at": [27.2, 9], "params": { "doorSpeed": 0.6 } },
    { "id": "door-2", "prefab": "doorway", "z": 3, "at": [33, 11.6], "flip": true },
    { "id": "latch-3", "prefab": "one-way-latch", "at": [34.6, 11.6] }
  ],
  "solid": [
    ["box", 12, 11.8, 11.6, 0.2],
    ["box", 0.2, 6, 0.2, 6],
    ["box", 23.8, 6, 0.2, 6],
    ["box", 2, 10, 0.6, 0.1, 15],
    ["circle", 3.8, 11.1, 0.5],
    ["capsule", 5.4, 11.4, 0.4, 0.2, 90],
    ["poly", 6.2, 11.6, 7, 11.6, 6.6, 11],
    ["chain", 1, 7, 3, 7.4, 5, 7],
    ["box", 30, 11.8, 6, 0.2],
    ["box", 35.8, 5.8, 0.2, 5.8]
  ],
  "entities": [
    { "id": "shelf", "type": "node", "name": "Shelf", "at": [14, 7] },
    { "id": "wing", "type": "node", "name": "Wing", "at": [32, 4], "rot": 270, "flip": true },
    { "id": "ledge", "type": "solid", "shape": ["box", 8.2, 9, 0.8, 0.1], "material": "bouncy", "oneWay": true, "behaviors": { "sprite": { "asset": "hero", "frame": "hero-1", "size": [1.6, 0.2] } } },
    { "id": "zone", "type": "sensor", "shape": ["box", 10, 11.2, 0.4, 0.4], "tags": ["goal"] },
    { "id": "start", "type": "marker", "at": [7.6, 11.4], "tags": ["spawn"] },
    { "id": "crate", "type": "prop", "shape": ["box", 8.8, 11.4, 0.2, 0.2], "density": 1, "restitution": 0, "behaviors": { "sprite": { "asset": "crates", "frame": "crate-0", "size": [0.72, 0.72] } } },
    { "id": "ball", "type": "prop", "shape": ["circle", 10, 10.5, 0.2], "density": 2, "restitution": 0.3, "behaviors": { "sprite": { "asset": "crates", "blend": "add", "frame": "crate-1", "size": [0.4, 0.4], "tint": 16764040 } } },
    { "id": "carrier", "type": "follower", "shape": ["box", 0, 0, 0.6, 0.08], "path": { "pts": [[7.6, 4], [12.4, 4]], "mode": "ping_pong", "speed": 1, "pauseMs": 300 } },
    { "id": "deck", "type": "solid", "parent": "carrier", "shape": ["box", 0, -0.2, 0.2, 0.12] },
    { "id": "deck-zone", "type": "sensor", "parent": "carrier", "shape": ["box", 0, -0.6, 0.4, 0.2], "tags": ["riding"] },
    { "id": "orbit", "type": "follower", "shape": ["circle", 0, 0, 0.16], "path": { "pts": [[17, 2], [19, 2], [18, 3.6]], "mode": "loop", "speed": 0.6 } },
    { "id": "shelf-board", "type": "solid", "parent": "shelf", "shape": ["box", 0, 0, 1, 0.1] },
    { "id": "shelf-box", "type": "prop", "parent": "shelf", "shape": ["box", -0.4, -0.3, 0.2, 0.2], "density": 1, "restitution": 0 },
    { "id": "shelf-mark", "type": "marker", "parent": "shelf", "at": [0.4, -0.2], "tags": ["shelf"] },
    { "id": "about", "type": "note", "at": [0.6, 0.4], "text": "Kitchen sink: every engine primitive, bulk shape form, node, prefab and parented entity in one scene, with turned and flipped instances and nodes, nested prefabs, variants, params, child refs, z, the assets header (naming the cards table) and sprites of the art folder's atlas, sheet and texture. Each region has a note." },
    { "id": "about-bulk", "type": "note", "at": [0.6, 6.4], "text": "Bulk solids, one per shape form: the floor and walls (box), a rotated box, circle, capsule, poly and chain." },
    { "id": "about-primitives", "type": "note", "at": [7.4, 8.2], "text": "Entity primitives: a one-way solid ledge of the project's bouncy material, a sensor zone the ball falls into, a spawn marker and two props (box and circle)." },
    { "id": "about-follower", "type": "note", "at": [7.4, 2.6], "text": "Followers: carrier ping-pongs carrying its children, a solid deck and a sensor; orbit loops a closed triangle." },
    { "id": "about-nodes", "type": "note", "at": [13, 5.6], "text": "Nodes: shelf holds three children stored relative to its origin, so moving it is one edit; hook, a node turned a quarter, holds hook-mark 0.6 m along its turned x, straight below it; pivot turns 30°, an angle that isn't a quarter, and holds pivot-mark 0.6 m along its turned x." },
    { "id": "about-prefabs", "type": "note", "at": [16, 8.6], "text": "Prefabs: two post instances, and two gate instances where gate-2 overrides its bar to be one-way. cap-flag is a child of post-1/cap, an instance's child, and goes where the post goes." },
    { "id": "wing-board", "type": "solid", "parent": "wing", "z": 2, "shape": ["box", 0.4, 0, 0.4, 0.08] },
    { "id": "wing-zone", "type": "sensor", "parent": "wing", "shape": ["box", 0.6, -0.3, 0.2, 0.1], "tags": ["wing"] },
    { "id": "wing-mark", "type": "marker", "parent": "wing", "at": [0.8, 0.2], "tags": ["wing"] },
    { "id": "rider", "type": "sensor", "parent": "room-1/door-1/panel", "z": -1, "shape": ["box", 0, -0.5, 0.12, 0.1], "tags": ["riding"] },
    { "id": "about-nesting", "type": "note", "at": [24.4, 2.4], "text": "Nesting: room-1 holds a doorway, which holds a latch, and a latch of its own: three levels. Its doorSpeed param feeds the doorway's panel, which carries rider, its child by the child ref room-1/door-1/panel. door-2 is a flipped doorway drawn at z 3; latch-3 places one-way-latch, a variant of latch." },
    { "id": "about-wing", "type": "note", "at": [30, 1.2], "text": "Node wing: turned and flipped. Its children are stored unturned, relative to its origin, and wing-board sits at z 2." },
    { "id": "lamp", "type": "decor", "layer": "decor", "at": [6, 10.4], "behaviors": { "sprite": { "asset": "backdrop", "scale": 4 } } },
    { "id": "about-sprites", "type": "note", "at": [4.4, 9.6], "text": "Sprites: crate draws the crates atlas's crate-0, ball its crate-1 tinted and added, ledge the hero sheet's hero-1 under the bouncy material's tint, and the decor lamp the backdrop texture at scale 4." },
    { "id": "floor-plan", "type": "nav", "shape": ["poly", 19, 3, 23, 3, 23, 4, 20.5, 4, 20.5, 5.5, 19, 5.5], "tags": ["hall"] },
    { "id": "about-nav", "type": "note", "at": [19, 2.8], "text": "Navigation: floor-plan is a concave walk area with the pillar hole cut out of it; ctx.nav paths across it, around the pillar, without physics or a grid." },
    { "id": "pillar", "type": "nav", "shape": ["poly", 21.2, 3.3, 21.8, 3.3, 21.8, 3.7, 21.2, 3.7], "mode": "block" },
    { "id": "side-wall", "type": "solid", "shape": ["box", 3, 2.2, 0.08, 0.6], "oneWay": "left" },
    { "id": "upright", "type": "prop", "shape": ["box", 3.12, 1.4, 0.1, 0.1], "density": 1, "fixedRotation": true, "restitution": 0 },
    { "id": "about-sides", "type": "note", "at": [2, 0.6], "text": "One-way sides and body fields: side-wall is one-way from the left, so an actor passes it moving left and stops on its left face; upright starts half past its top and slides off without turning (fixedRotation)." },
    { "id": "spark", "type": "decor", "layer": "decor", "at": [13.4, 10.4], "behaviors": { "lifetime": { "ticks": 30 }, "sprite": { "asset": "crates", "frame": "crate-1", "size": [0.24, 0.24] } } },
    { "id": "about-lifetime", "type": "note", "at": [12.6, 9.6], "text": "Lifetime: spark is a decor whose lifetime block destroys it 30 ticks after load; the fades check expects the lamp and std-tween to remain the two decors left." },
    { "id": "std-collider", "type": "marker", "at": [14.7, 3], "behaviors": { "collider": { "shape": ["box", 0, 0, 1.5, 0.1] } } },
    { "id": "std-body", "type": "marker", "at": [13.6, 2.6], "behaviors": { "body": {}, "collider": { "shape": ["box", 0, 0, 0.15, 0.15] } } },
    { "id": "std-side-view", "type": "marker", "at": [14.2, 2.5], "behaviors": { "character-side-view": {}, "collider": { "shape": ["box", 0, 0, 0.1, 0.2] } } },
    { "id": "std-top-down", "type": "marker", "at": [14.8, 2.6], "behaviors": { "character-top-down": {}, "collider": { "shape": ["circle", 0, 0, 0.15] } } },
    { "id": "std-player-input", "type": "marker", "at": [15.4, 2.6], "behaviors": { "player-input": {} } },
    { "id": "std-joint", "type": "marker", "at": [16.5, 3.1], "behaviors": { "body": {}, "collider": { "shape": ["box", 0, 0, 0.1, 0.1] }, "joint": { "anchorA": [-0.5, 0], "anchorB": [1.3, 0.1], "kind": "revolute", "to": "std-collider" } } },
    { "id": "std-force-area", "type": "marker", "at": [13.6, 1.6], "behaviors": { "collider": { "sensor": true, "shape": ["box", 0, 0, 0.3, 0.3] }, "force-area": { "force": [0, -15] } } },
    { "id": "std-path-follow", "type": "marker", "at": [12.8, 1], "behaviors": { "path-follow": { "path": { "mode": "ping_pong", "pts": [[12.8, 1], [15.6, 1]], "speed": 0.6 } } } },
    { "id": "std-spawner", "type": "marker", "at": [15.6, 1.8], "behaviors": { "spawner": { "cap": 2, "fields": { "shape": ["box", 0, 0, 0.1, 0.1] }, "rate": 0.5, "type": "solid" } } },
    { "id": "std-nav-agent", "type": "marker", "at": [19.6, 5], "behaviors": { "nav-agent": {} } },
    { "id": "std-camera-target", "type": "marker", "at": [12, 6], "behaviors": { "camera-target": {} } },
    { "id": "about-behaviors", "type": "note", "at": [12.6, 0.4], "text": "Standard behaviors, one entity each: std-collider is the static shelf; on it std-body falls and rests, std-side-view stands, std-top-down floats and std-player-input binds seat 0; std-joint swings on a hinge to the shelf's end; std-force-area pushes up with nothing inside; std-path-follow ping-pongs above; std-spawner places up to two small solids, its fields' box moved to its pose; std-nav-agent waits on floor-plan; std-camera-target is what Play's camera follows." },
    { "id": "framing", "type": "camera-region", "shape": ["box", 15, 4, 6, 3.5], "ease": 0.5, "zoom": 1.5 },
    { "id": "about-camera", "type": "note", "at": [9.4, 7.2], "text": "framing is a camera region, its outline shown only while editing. In Play the scene's camera settings put a rig on the camera: following std-camera-target, it eases into the region's box at zoom 1.5 and keeps the view inside it, where std-anim, std-tween and std-emitter play." },
    { "id": "std-anim", "type": "marker", "at": [10.6, 5.2], "behaviors": { "anim": { "clip": "idle", "source": "kitchen-animation" }, "sprite": { "asset": "hero", "frame": "hero-0", "size": [0.48, 0.48] } } },
    { "id": "std-tween", "type": "decor", "layer": "decor", "at": [11.6, 5.2], "behaviors": { "sprite": { "asset": "crates", "frame": "crate-0", "size": [0.36, 0.36] }, "tween": { "tweens": [{ "duration": { "ms": 800 }, "ease": "sineInOut", "repeat": -1, "to": { "alpha": 0.5, "y": 4.8 }, "yoyo": true }] } } },
    { "id": "std-emitter", "type": "marker", "at": [12.8, 5.4], "behaviors": { "emitter": { "preset": "sparks" } } },
    { "id": "about-motion", "type": "note", "at": [10, 4.4], "text": "Animation, tweens and particles: std-anim plays the kitchen-animation's idle clip (the hero sheet's idle tag), which also holds jab, a once clip raising strike with a hit shape set on its second frame; std-tween is a decor bobbing up and fading on a yoyo tween; std-emitter sprays the sparks preset, drawn only." },
    { "id": "pivot", "type": "node", "name": "Pivot", "at": [9.4, 8.2], "rot": 30 },
    { "id": "cap-flag", "type": "marker", "parent": "post-1/cap", "at": [0, -0.2], "tags": ["flag"] },
    { "id": "hook", "type": "node", "name": "Hook", "at": [15, 3.6], "rot": 90 },
    { "id": "hook-mark", "type": "marker", "parent": "hook", "at": [0.6, 0], "tags": ["hook"] },
    { "id": "pivot-mark", "type": "marker", "parent": "pivot", "at": [0.6, 0], "tags": ["pivot"] }
  ]
}
