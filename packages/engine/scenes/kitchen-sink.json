    { "id": "shelf-mark", "type": "marker", "group": "shelf", "at": [0.4, -0.2], "tags": ["shelf"] },
    { "id": "about", "type": "note", "at": [0.6, 0.4], "text": "Kitchen sink: every engine primitive, bulk shape form, group, prefab and attachment in one scene, with format v3's transforms, nested prefabs, variants, params, child refs, z, the assets header (naming the cards table) and sprites of the art folder's atlas, sheet and texture. Each region has a note." },
    { "id": "about-bulk", "type": "note", "at": [0.6, 6.4], "text": "Bulk solids, one per shape form: the floor and walls (box), a rotated box, circle, capsule, poly and chain." },
    { "id": "about-primitives", "type": "note", "at": [7.4, 8.2], "text": "Entity primitives: a one-way solid ledge of the project's bouncy material, a sensor zone the ball falls into, a spawn marker and two props (box and circle)." },
    { "id": "about-follower", "type": "note", "at": [7.4, 2.6], "text": "Followers: carrier ping-pongs with a solid deck and a sensor attached to it; orbit loops a closed triangle." },
    { "id": "about-group", "type": "note", "at": [13, 5.6], "text": "Group shelf: three members stored relative to the group's origin, so moving the group is one edit." },
    { "id": "about-prefabs", "type": "note", "at": [16, 8.6], "text": "Prefabs: two post instances, and two gate instances where gate-2 overrides its bar to be one-way." },
    { "id": "wing-board", "type": "solid", "group": "wing", "z": 2, "shape": ["box", 0.4, 0, 0.4, 0.08] },
    { "id": "wing-zone", "type": "sensor", "group": "wing", "shape": ["box", 0.6, -0.3, 0.2, 0.1], "tags": ["wing"] },
    { "id": "wing-mark", "type": "marker", "group": "wing", "at": [0.8, 0.2], "tags": ["wing"] },
    { "id": "rider", "type": "sensor", "z": -1, "shape": ["box", 25.7, 8.1, 0.12, 0.1], "attach": "room-1/door-1/panel", "tags": ["riding"] },
    { "id": "about-nesting", "type": "note", "at": [24.4, 2.4], "text": "Nesting: room-1 holds a doorway, which holds a latch, and a latch of its own: three levels. Its doorSpeed param feeds the doorway's panel, which rider rides by the child ref room-1/door-1/panel. door-2 is a flipped doorway drawn at z 3; latch-3 places one-way-latch, a variant of latch." },
    { "id": "about-wing", "type": "note", "at": [30, 1.2], "text": "Group wing: turned and flipped. Its members are stored unturned, relative to its origin, and wing-board sits at z 2." },
    { "id": "lamp", "type": "decor", "layer": "decor", "at": [6, 10.4], "behaviors": { "sprite": { "asset": "backdrop", "scale": 4 } } },
    { "id": "about-sprites", "type": "note", "at": [4.4, 9.6], "text": "Sprites: crate draws the crates atlas's crate-0, ball its crate-1 tinted and added, ledge the hero sheet's hero-1 under the bouncy material's tint, and the decor lamp the backdrop texture at scale 4." },
    { "id": "floor-plan", "type": "nav", "shape": ["poly", 19, 3, 23, 3, 23, 4, 20.5, 4, 20.5, 5.5, 19, 5.5], "tags": ["hall"] },
    { "id": "about-nav", "type": "note", "at": [19, 2.8], "text": "Navigation: floor-plan is a concave walk area with the pillar hole cut out of it; ctx.nav paths across it, around the pillar, without physics or a grid." },
    { "id": "pillar", "type": "nav", "shape": ["poly", 21.2, 3.3, 21.8, 3.3, 21.8, 3.7, 21.2, 3.7], "mode": "block" },
    { "id": "side-wall", "type": "solid", "shape": ["box", 3, 2.2, 0.08, 0.6], "oneWay": "left" },
    { "id": "upright", "type": "prop", "shape": ["box", 3.12, 1.4, 0.1, 0.1], "density": 1, "fixedRotation": true, "restitution": 0 },
    { "id": "about-sides", "type": "note", "at": [2, 0.6], "text": "One-way sides and body fields: side-wall is one-way from the left, so an actor passes it moving left and stops on its left face; upright starts half past its top and slides off without turning (fixedRotation)." },
    { "id": "spark", "type": "decor", "layer": "decor", "at": [13.4, 10.4], "behaviors": { "lifetime": { "ticks": 30 }, "sprite": { "asset": "crates", "frame": "crate-1", "size": [0.24, 0.24] } } },
    { "id": "about-lifetime", "type": "note", "at": [12.6, 9.6], "text": "Lifetime: spark is a decor whose lifetime block destroys it 30 ticks after load; the fades check expects the lamp to remain the one decor left." },
    { "id": "std-collider", "type": "marker", "at": [14.7, 3], "behaviors": { "collider": { "shape": ["box", 0, 0, 1.5, 0.1] } } },
    { "id": "std-body", "type": "marker", "at": [13.6, 2.6], "behaviors": { "body": {}, "collider": { "shape": ["box", 0, 0, 0.15, 0.15] } } },
    { "id": "std-side-view", "type": "marker", "at": [14.2, 2.5], "behaviors": { "character-side-view": {}, "collider": { "shape": ["box", 0, 0, 0.1, 0.2] } } },
    { "id": "std-top-down", "type": "marker", "at": [14.8, 2.6], "behaviors": { "character-top-down": {}, "collider": { "shape": ["circle", 0, 0, 0.15] } } },
    { "id": "std-player-input", "type": "marker", "at": [15.4, 2.6], "behaviors": { "player-input": {} } },
    { "id": "std-joint", "type": "marker", "at": [16.5, 3.1], "behaviors": { "body": {}, "collider": { "shape": ["box", 0, 0, 0.1, 0.1] }, "joint": { "anchorA": [-0.5, 0], "anchorB": [1.3, 0.1], "kind": "revolute", "to": "std-collider" } } },
    { "id": "std-force-area", "type": "marker", "at": [13.6, 1.6], "behaviors": { "collider": { "sensor": true, "shape": ["box", 0, 0, 0.3, 0.3] }, "force-area": { "force": [0, -15] } } },
    { "id": "std-path-follow", "type": "marker", "at": [12.8, 1], "behaviors": { "path-follow": { "path": { "mode": "ping_pong", "pts": [[12.8, 1], [15.6, 1]], "speed": 0.6 } } } },
    { "id": "std-spawner", "type": "marker", "at": [15.6, 1.8], "behaviors": { "spawner": { "cap": 2, "rate": 0.5, "type": "marker" } } },
    { "id": "std-nav-agent", "type": "marker", "at": [19.6, 5], "behaviors": { "nav-agent": {} } },
    { "id": "std-camera-target", "type": "marker", "at": [12, 6], "behaviors": { "camera-target": {} } },
    { "id": "about-behaviors", "type": "note", "at": [12.6, 0.4], "text": "Standard behaviors, one entity each: std-collider is the static shelf; on it std-body falls and rests, std-side-view stands, std-top-down floats and std-player-input binds seat 0; std-joint swings on a hinge to the shelf's end; std-force-area pushes up with nothing inside; std-path-follow ping-pongs above; std-spawner places up to two markers; std-nav-agent waits on floor-plan; std-camera-target is what Play's camera follows." }
  ]
}
