{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jams-engine:scene-version:v1",
  "x-agent-surface": 22,
  "title": "jams engine scene version, format v1",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The scene version JSON Schema this file follows.",
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "scene-version",
      "description": "Always \"scene-version\"."
    },
    "v": {
      "type": "number",
      "const": 1,
      "description": "Scene version format version."
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
      "description": "The project's id."
    },
    "scene": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
      "description": "The scene asset this version replaces; listed in the release's flow."
    },
    "compat": {
      "type": "object",
      "properties": {
        "formats": {
          "type": "object",
          "properties": {
            "scene": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "The scene format version."
            },
            "prefab": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "The prefab format version."
            }
          },
          "required": ["scene", "prefab"],
          "additionalProperties": false,
          "description": "The formats of the code that checked the version."
        },
        "build": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "description": "An asset kind: an engine kind's name, or `<game>/<kind>` for a game's."
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "The kind's schema hash."
          },
          "description": "The per-kind schema hashes of the code that checked the version."
        },
        "game": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
              "description": "The game's id."
            },
            "configHash": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "The game's configHash; null when it declares none."
            }
          },
          "required": ["id", "configHash"],
          "additionalProperties": false,
          "description": "The game the version was made for."
        }
      },
      "required": ["formats", "build", "game"],
      "additionalProperties": false,
      "description": "What a release must match for the version to go live on it."
    },
    "engine": {
      "type": "string",
      "minLength": 1,
      "description": "ENGINE_VERSION of the code that built it; never compared."
    },
    "base": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The release it was checked against when built; provenance only."
        },
        {
          "type": "null"
        }
      ],
      "description": "The release it was checked against when built; null when none."
    },
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
          "description": "The scene's asset id."
        },
        "title": {
          "description": "Its title in the scene list.",
          "type": "string",
          "minLength": 1
        },
        "sublevel": {
          "description": "Listed as a sublevel in the scene list.",
          "type": "boolean",
          "const": true
        },
        "physics": {
          "type": "string",
          "enum": ["rapier", "none"],
          "description": "Whether the scene needs Rapier."
        },
        "prefabs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
            "description": "An asset id."
          },
          "description": "Prefabs its expansion uses, by id, sorted."
        },
        "bundle": {
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
                "description": "An asset id."
              },
              "description": "The blobs, by asset id, sorted."
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Their total size in bytes."
            }
          },
          "required": ["entries", "bytes"],
          "additionalProperties": false,
          "description": "The blobs to fetch before its first frame."
        }
      },
      "required": ["id", "physics", "prefabs", "bundle"],
      "additionalProperties": false,
      "description": "A listed scene."
    },
    "sceneHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "sceneHash of the canonical scene text: what the editor and replays display."
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
        "description": "An asset id."
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "description": "The asset's registry key, which never changes."
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "description": "An asset kind: an engine kind's name, or `<game>/<kind>` for a game's."
          },
          "path": {
            "type": "string",
            "description": "The asset's project-relative POSIX path in the project the build was made from."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "A doc's SHA-256 of its canonical text, a blob's of its bytes."
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "The size of the asset's file in the build."
          },
          "storage": {
            "type": "string",
            "enum": ["doc", "blob"],
            "description": "Whether the asset is a doc or a blob."
          },
          "file": {
            "type": "string",
            "pattern": "^live\\/[0-9a-f]{64}(\\.[A-Za-z0-9]+)*$",
            "description": "Its file under the version: `live/<sha256>.json` or `live/<sha256><ext>`."
          },
          "name": {
            "description": "Display name; absent means the path's stem.",
            "type": "string",
            "minLength": 1
          },
          "meta": {
            "description": "A blob's inspected facts (an atlas's frames, a texture's size).",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "import": {
            "description": "A blob's import settings.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "licence": {
            "type": "object",
            "properties": {
              "spdx": {
                "description": "An SPDX id (\"CC-BY-4.0\") or \"proprietary\".",
                "type": "string",
                "minLength": 1
              },
              "author": {
                "description": "Who made it.",
                "type": "string",
                "minLength": 1
              },
              "source": {
                "description": "Where it came from: a URL or a description.",
                "type": "string",
                "minLength": 1
              },
              "attribution": {
                "description": "The exact credit line the licence asks for; the credits page prints it.",
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "description": "The asset's licence and credit."
          }
        },
        "required": ["key", "kind", "path", "sha256", "bytes", "storage", "file"],
        "additionalProperties": false,
        "description": "An asset the version needs: its snapshot entry plus its file under `live/`."
      },
      "description": "Every asset the version needs, by id."
    }
  },
  "required": [
    "kind",
    "v",
    "project",
    "scene",
    "compat",
    "engine",
    "base",
    "entry",
    "sceneHash",
    "assets"
  ],
  "additionalProperties": false,
  "description": "One published version of one scene (scene-version.json): the scene, its prefabs and the assets they need, and what a release must match for it to go live."
}
