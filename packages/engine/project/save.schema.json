{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jams-engine:save:v1",
  "x-agent-surface": 16,
  "title": "jams engine save file, format v1",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The JSON Schema this file follows.",
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "save",
      "description": "Always `save`."
    },
    "v": {
      "type": "number",
      "const": 1,
      "description": "The save format version."
    },
    "game": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
      "description": "The id of the game that wrote it."
    },
    "gameVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "The game's `saves.version` when it was written."
    },
    "engine": {
      "type": "string",
      "minLength": 1,
      "description": "The engine version that wrote it."
    },
    "release": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "The release it was played in; null outside one."
    },
    "project": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
              "description": "The project's id."
            },
            "snapshot": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "The project snapshot's hash."
            }
          },
          "required": ["id", "snapshot"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "The project snapshot it was played from; null without one."
    },
    "slot": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
      "description": "The slot it was saved to."
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "description": "What a save menu shows for it.",
          "type": "string"
        },
        "scene": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
          "description": "The main scene it was saved in."
        },
        "savedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "The host's clock when saved, ms since the epoch."
        },
        "playTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Ticks played in the run that saved it."
        }
      },
      "required": ["scene", "savedAt", "playTicks"],
      "additionalProperties": false,
      "description": "What a save menu lists it by."
    },
    "depth": {
      "type": "string",
      "enum": ["progress", "world"],
      "description": "`progress`, or `world` to continue exactly."
    },
    "persist": {
      "description": "The game's persistent state.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ],
      "$ref": "#/$defs/JsonValue"
    },
    "scene": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
          "description": "The main scene."
        },
        "runHash": {
          "type": "string",
          "description": "The run hash it was saved under; a different one loads with a note."
        },
        "entry": {
          "description": "The entry the scene was reached through, its `ctx.flow.entry`.",
          "type": "string"
        },
        "sublevels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
                "description": "The sublevel's label, its entities' id prefix."
              },
              "scene": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
                "description": "The scene attached."
              },
              "at": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "description": "x, metres."
                  },
                  {
                    "type": "number",
                    "description": "y, metres."
                  }
                ],
                "description": "Where its origin sits in the main scene, metres."
              }
            },
            "required": ["label", "scene", "at"],
            "additionalProperties": false,
            "description": "A sublevel attached when it was saved."
          },
          "description": "Sublevels attached, in attach order."
        }
      },
      "required": ["id", "runHash", "sublevels"],
      "additionalProperties": false,
      "description": "The scene it was saved in."
    },
    "data": {
      "description": "The game's own data, its `snapshot()`.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ],
      "$ref": "#/$defs/JsonValue"
    },
    "world": {
      "type": "object",
      "properties": {
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "The tick it was saved at."
        },
        "counters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "description": "Runtime id counters by name."
        },
        "random": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "description": "A 32-bit state word."
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "description": "A 32-bit state word."
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "description": "A 32-bit state word."
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "description": "A 32-bit state word."
            }
          ],
          "description": "`ctx.random`'s state."
        },
        "timers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "The timer's id."
              },
              "due": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "The tick it fires on."
              },
              "period": {
                "description": "Ticks between repeats.",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "times": {
                "description": "Repeats left.",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "emit": {
                "type": "string",
                "minLength": 1,
                "description": "The event it emits."
              },
              "entityId": {
                "description": "The entity the event names.",
                "type": "string"
              },
              "data": {
                "description": "The event's data.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/__schema0"
                    }
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/__schema0"
                    }
                  }
                ],
                "$ref": "#/$defs/JsonValue"
              },
              "owner": {
                "description": "The system or behavior that set it.",
                "type": "string"
              }
            },
            "required": ["id", "due", "emit"],
            "additionalProperties": false,
            "description": "A pending emit-form timer."
          },
          "description": "Pending emit-form timers."
        },
        "enabled": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "boolean",
            "const": false
          },
          "description": "Entities disabled, by id."
        },
        "destroyed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Scene entities destroyed since the load."
        },
        "spawned": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "The id it was given."
              },
              "input": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The entity type."
                  },
                  "id": {
                    "description": "The id it asked for.",
                    "type": "string"
                  },
                  "sublevel": {
                    "description": "The sublevel it belongs to.",
                    "type": "string"
                  }
                },
                "required": ["type"],
                "additionalProperties": {},
                "description": "The spawn's input, the type's own fields beside these."
              },
              "instance": {
                "type": "object",
                "properties": {
                  "prefab": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
                    "description": "The prefab instantiated."
                  },
                  "rot": {
                    "description": "Quarter turns.",
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 0
                      },
                      {
                        "type": "number",
                        "const": 1
                      },
                      {
                        "type": "number",
                        "const": 2
                      },
                      {
                        "type": "number",
                        "const": 3
                      }
                    ]
                  },
                  "flip": {
                    "description": "Mirrored on x.",
                    "type": "boolean"
                  },
                  "z": {
                    "description": "Draw order.",
                    "type": "number"
                  },
                  "layer": {
                    "description": "The layer it was placed on.",
                    "type": "string"
                  },
                  "params": {
                    "description": "The prefab's params.",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "overrides": {
                    "description": "Overrides by path.",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": ["prefab"],
                "additionalProperties": false,
                "description": "The prefab instance a spawn came from."
              }
            },
            "required": ["id", "input"],
            "additionalProperties": false,
            "description": "An entity spawned at run time."
          },
          "description": "Entities spawned at run time, in spawn order."
        },
        "poses": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "description": "x, metres."
              },
              {
                "type": "number",
                "description": "y, metres."
              },
              {
                "type": "number",
                "description": "The angle, radians."
              }
            ]
          },
          "description": "`[x, y, angle]` by entity id, metres and radians."
        },
        "systems": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "description": "Any JSON value.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema0"
                  }
                }
              ],
              "$ref": "#/$defs/JsonValue"
            }
          },
          "description": "Each entity's saved state by owner; `@random` holds the random forks."
        },
        "seats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "player": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "The seat."
              },
              "devices": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:keyboard|pointer|touch|pad:\\d+)$",
                  "description": "A device: `keyboard`, `pointer`, `touch` or `pad:<n>`."
                },
                "description": "The devices it held."
              }
            },
            "required": ["player", "devices"],
            "additionalProperties": false,
            "description": "An input seat."
          },
          "description": "Input seats and their devices."
        }
      },
      "required": [
        "tick",
        "counters",
        "random",
        "timers",
        "enabled",
        "destroyed",
        "spawned",
        "poses",
        "systems",
        "seats"
      ],
      "additionalProperties": false,
      "description": "Everything a run needs to continue exactly; depth `world` only."
    }
  },
  "required": [
    "kind",
    "v",
    "game",
    "gameVersion",
    "engine",
    "release",
    "project",
    "slot",
    "meta",
    "depth",
    "persist",
    "scene",
    "data"
  ],
  "additionalProperties": false,
  "description": "A save:v1 file: the engine's envelope around a game's own data.",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "JsonValue": {
      "$ref": "#/$defs/__schema0"
    }
  }
}
