{
  "name": "brackeys",
  "version": "0.0.0-alpha.458",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_CF_IMAGES= dotenv -e .env.local -- vp dev --port 3000",
    "build": "vp build && cp instrument.server.mjs .output/server",
    "preview": "vp preview",
    "test": "vp test run",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:export": "drizzle-kit export",
    "scraper:drain": "bun run --cwd services/itchio-scraper drain",
    "scraper:backfill": "bun run --cwd services/itchio-scraper backfill",
    "backfill:projects": "bun scripts/backfill-projects.ts",
    "check": "vp check --no-fmt",
    "lint": "vp lint",
    "check:changed": "git diff --cached --name-only --diff-filter=d | xargs bun vp check --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook:test": "storybook build --test --stats-json",
    "chromatic": "bun run build-storybook:test && chromatic --storybook-build-dir storybook-static",
    "prepare": "vp config",
    "commit": "cz",
    "railway:dev": "railway run -- sh -c 'BETTER_AUTH_URL=http://localhost:3000 VITE_CF_IMAGES= REDIS_URL=\"${REDIS_PUBLIC_URL:-$REDIS_URL}\" vp dev --port 3000'",
    "railway:build": "railway run -- vp build && cp instrument.server.mjs .output/server",
    "railway:start": "railway run -- node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "railway:db:generate": "railway run -- drizzle-kit generate",
    "railway:db:introspect": "railway run -- drizzle-kit introspect",
    "railway:db:migrate": "railway run -- drizzle-kit migrate",
    "railway:db:push": "railway run -- drizzle-kit push",
    "railway:db:studio": "railway run -- drizzle-kit studio",
    "railway:backfill:projects": "railway run --service TimescaleDB -- sh -c 'DATABASE_URL=\"$DATABASE_PUBLIC_URL\" bun scripts/backfill-projects.ts'",
    "railway:backfill:projects:dry": "railway run --service TimescaleDB -- sh -c 'DATABASE_URL=\"$DATABASE_PUBLIC_URL\" bun scripts/backfill-projects.ts --dry-run'",
    "railway:seed:projects": "railway run --service TimescaleDB -- sh -c 'DATABASE_URL=\"$DATABASE_PUBLIC_URL\" bun scripts/seed-test-projects.ts'",
    "railway:seed:projects:clean": "railway run --service TimescaleDB -- sh -c 'DATABASE_URL=\"$DATABASE_PUBLIC_URL\" bun scripts/seed-test-projects.ts --clean'",
    "railway:scraper:drain": "railway run --service TimescaleDB -- sh -c 'DATABASE_URL=\"$DATABASE_PUBLIC_URL\" bun run --cwd services/itchio-scraper drain'",
    "railway:scraper:backfill": "railway run --service TimescaleDB -- sh -c 'DATABASE_URL=\"$DATABASE_PUBLIC_URL\" bun run --cwd services/itchio-scraper backfill'",
    "railway:scraper:resync": "railway run --service TimescaleDB -- sh -c 'DATABASE_URL=\"$DATABASE_PUBLIC_URL\" bun run --cwd services/itchio-scraper resync'"
  },
