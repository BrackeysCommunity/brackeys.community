      "types": "./dist/scene.d.mts",
      "import": "./dist/scene.mjs"
    },
    "./editor": {
      "types": "./dist/editor.d.mts",
      "import": "./dist/editor.mjs"
    },
    "./collab": {
      "types": "./dist/collab.d.mts",
      "import": "./dist/collab.mjs"
    },
    "./headless": {
      "types": "./dist/headless.d.mts",
      "import": "./dist/headless.mjs"
    },
    "./game": {
      "types": "./dist/game.d.mts",
      "import": "./dist/game.mjs"
    },
    "./debug": {
      "types": "./dist/debug.d.mts",
      "import": "./dist/debug.mjs"
    },
    "./sim-kit": {
      "types": "./dist/sim-kit.d.mts",
      "import": "./dist/sim-kit.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
