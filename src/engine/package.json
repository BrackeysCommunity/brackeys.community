  "peerDependencies": {
    "@dimforge/rapier2d": "^0.19.3",
    "@dimforge/rapier2d-compat": "^0.19.3",
    "@hocuspocus/server": "^4.7.0",
    "@tanstack/store": ">=0.8.1 <0.9.0",
    "fractional-indexing": "^4.0.0",
    "pixi.js": "^8.17.1",
    "yjs": "^13.6.33",
    "zod": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier2d-compat": {
      "optional": true
    },
    "@hocuspocus/server": {
      "optional": true
    }
