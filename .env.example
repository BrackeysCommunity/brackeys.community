DATABASE_URL="postgresql://localhost:5432/brackeys"

BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-me"

DISCORD_CLIENT_ID="replace-me"
DISCORD_CLIENT_SECRET="replace-me"
DISCORD_GUILD_ID="replace-me"
DISCORD_BOT_TOKEN="replace-me"

# The channel collab posts are mirrored into, when their author presses
# SHARE TO DISCORD on their own post. Unset means the feature does not
# exist: the button never renders and the procedure answers NOT_IMPLEMENTED,
# which is the local default. The bot needs View Channel, Send Messages and
# Embed Links there (and Manage Messages is not needed — it only ever edits
# or deletes its own messages).
DISCORD_COLLAB_CHANNEL_ID=""
# The forum's #devlogs channel: a devlog whose author ticks "Share to
# #devlogs" is mirrored there. Unset hides the option. Same permissions.
DISCORD_DEVLOGS_CHANNEL_ID=""
# How long one member must wait between announcing posts in that channel.
# Editing a message they already posted is not announcing, and is limited
# separately (10/hour). Seconds; default 21600 (6 hours).
DISCORD_COLLAB_SHARE_COOLDOWN_SECONDS=""

# Comma-separated Discord user IDs granted Admin regardless of guild roles
# (owner break-glass; applied when guild roles sync).
ADMIN_DISCORD_IDS=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitLab account linking — one OAuth application per instance in
# src/lib/gitlab-instances.ts, scope `read_user`, redirect URI
# <origin>/api/auth/oauth2/callback/<providerId>. Register the application
# NON-CONFIDENTIAL and the id below is all you need: that's a public PKCE
# client, and there is no secret to hold. The _CLIENT_SECRET lines are only
# for an instance whose admin requires a confidential app. An instance with
# no client id is simply absent from the LINKED menu.
GITLAB_CLIENT_ID=""
GITLAB_BOOTH_CLIENT_ID=""
GITLAB_BRACKEYS_CLIENT_ID=""
# GITLAB_CLIENT_SECRET=""
# GITLAB_BOOTH_CLIENT_SECRET=""
# GITLAB_BRACKEYS_CLIENT_SECRET=""

# 32 bytes base64 (`openssl rand -base64 32`) — seals linked_accounts
# access tokens at rest. Optional locally; set on Railway (Web + the
# itchio-library-sync service, all environments, same value).
LINKED_ACCOUNTS_ENC_KEY=""

VITE_ITCHIO_CLIENT_ID=""

# Image uploads — profile/project covers, team images, collab post galleries
# (MinIO / S3-compatible; one bucket, key-prefix namespaces)
MINIO_BUCKET=brackeys
MINIO_ENDPOINT=""
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""


VITE_APP_TITLE="Brackeys Community"
SERVER_URL="http://localhost:3000"
# The public origin this build serves from. Read through `siteOrigin()` and
# used for every canonical tag, `og:image`, `og:url`, the sitemap and the
# feed.
VITE_SITE_ORIGIN="http://localhost:3000"
# The origin link that the user will be redirected to after login in from
# discord oauth, by default it points to https://staging.brackeys.dev
# On discord developer portal you need to set the redirect URI to the
# following format:
# http://<origin>/api/auth/callback/discord
# Example:
# http://localhost:3000/api/auth/callback/discord
# http://example.com/api/auth/callback/discord
VITE_OAUTH_PROXY_ORIGIN="http://localhost:3000"
# Optional override for the staging marker (the badge beside the logo, the
# top-edge stripe, and the [STAGING] tab-title prefix). Left unset, the
# environment is derived from VITE_SITE_ORIGIN above: the canonical host is
# production, localhost is development, everything else is staging. Set it
# only where the origin can't tell the truth. One of
# production | staging | development.
VITE_DEPLOY_ENV=
# PostHog — analytics, feature flags, and error tracking. Leave the key empty
# to turn all three off locally (flags then fall back to the defaults in
# src/lib/flags.ts). Cookieless mode must also be enabled in the PostHog
# project settings or the events are dropped server-side.
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://eu.i.posthog.com"
# Build-time only, and never VITE_-prefixed (it is a write credential):
# uploads source maps so error stacks are un-minified. Absent = no upload,
# and the build is otherwise unchanged.
POSTHOG_PERSONAL_API_KEY=""
POSTHOG_PROJECT_ID=""
# Optional: the API/UI host for the upload (NOT the ingestion host above).
# POSTHOG_API_HOST="https://eu.posthog.com"

REDIS_URL="redis://localhost:6379"

# Email (Resend). Leave DISABLE_EMAIL=1 locally — with it set, every send
# short-circuits with a log line, so a real RESEND_API_KEY in your
# environment can't mail real users from a dev server. The notifications
# worker additionally requires APP_URL (validated at boot) so unsubscribe
# and notification links never silently point at production.
RESEND_API_KEY=""
# Optional From override; defaults to "Brackeys <noreply@brackeys.community>".
EMAIL_FROM=""
DISABLE_EMAIL="1"
