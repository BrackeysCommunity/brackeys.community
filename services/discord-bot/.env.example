# The bot user's token, from the Discord application's Bot page. The bot and
# the site's OAuth sign-in are one Discord application.
DISCORD_BOT_TOKEN=
# The application's id — the same value the web app calls DISCORD_CLIENT_ID.
# Either name is accepted; on Railway, reference the shared DISCORD_CLIENT_ID.
DISCORD_APPLICATION_ID=
# The home guild. Commands register as guild commands here and nowhere else.
DISCORD_GUILD_ID=

# Deep links and the API origin, one variable. Required, never defaulted:
# a staging bot pointed at production would answer with production data.
APP_URL=https://jams.team

# The host name `/jam now` looks up. The scrape carries host names only.
JAM_HOST_NAME=Brackeys

# Per-call budget for the public API, inside the 3 s interaction window
# once the reply is deferred.
BOT_API_TIMEOUT_MS=2000

# Optional. Same variables the other services read.
# POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# Who may share a command's answer to the channel (`share: true`). Comma-
# separated role ids; empty leaves sharing unrestricted. In the Brackeys
# guild: Admin, Mod, Guru.
SHARE_ROLE_IDS=
# The channel where anyone may share, because it exists for bot chatter,
# and how to name it in the one-line refusal.
BOT_CHANNEL_ID=
BOT_CHANNEL_NAME=bot

# Tell the site when a member changes avatar or name, so their profile
# resyncs at once instead of within the site's daily refresh. Needs the
# privileged "Server Members Intent", which the app holds (approved October
# 2026). Without it the gateway refuses the login and the bot crash-loops.
MEMBER_RELAY=false

# /summarize (plan 49): needs both, otherwise the command isn't registered.
REDIS_URL=
ANTHROPIC_API_KEY=
# SUMMARIZE_OPEN=false
# SUMMARY_COOLDOWN_LIMIT=3
# SUMMARY_COOLDOWN_WINDOW_MS=600000
