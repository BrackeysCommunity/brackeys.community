{
  "name": "@brackeys/discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Long-lived Railway service that answers slash commands in the Brackeys Discord server from the site's public API tier — a client of /api/public/rpc, never a second implementation of it.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "staging": "bun --env-file=.env.staging run src/index.ts",
    "register": "bun run src/register.ts",
    "register:staging": "bun --env-file=.env.staging run src/register.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/client": "^1.15.0",
    "discord.js": "^14.27.0",
    "posthog-node": "^5.49.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@orpc/server": "^1.15.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.14"
}
