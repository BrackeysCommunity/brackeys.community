{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun"],
    // api.ts imports the public router's *type* so the client is typed
    // against the live procedures, which pulls the app's router graph into
    // this typecheck. That graph is written against the root tsconfig, so
    // the options the root does not set stay off here too (the other
    // services turn on noUncheckedIndexedAccess; this one can't without
    // failing on app files it doesn't own), and its JSX and build-time
    // globals are declared (jsx below, src/app-globals.d.ts).
    "jsx": "react-jsx",
    "paths": {
      // The router's own files import through the app's `@/` alias, and
      // their bare specifiers (drizzle-orm, pg, ioredis) have to resolve to
      // the root copies so TS sees one module identity — same rule the other
      // services carry.
      "@/*": ["../../src/*"],
      "drizzle-orm": ["../../node_modules/drizzle-orm"],
      "drizzle-orm/*": ["../../node_modules/drizzle-orm/*"],
      "pg": ["../../node_modules/@types/pg"],
      "ioredis": ["../../node_modules/ioredis"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
