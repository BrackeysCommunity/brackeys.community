{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factions.archetypes",
  "title": "factions.archetypes",
  "description": "Faction archetypes, what they buy and tend to do.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "factions.archetypes"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "goal",
          "buys",
          "tags",
          "tends"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "goal": {
            "type": "string",
            "enum": [
              "hold",
              "take",
              "profit",
              "cleanse",
              "isolate"
            ],
            "x-unit": "enum"
          },
          "buys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "x-unit": "tags",
            "x-ref": "tags.vocabulary"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "x-unit": "tags",
            "x-ref": "tags.vocabulary",
            "description": "Disposition tags the faction carries."
          },
          "tends": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "x-unit": "refs",
            "x-ref": "factions.moves"
          }
        }
      }
    }
  }
}
