{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map.landmarks",
  "title": "map.landmarks",
  "description": "Features a region's highest free tile can hold.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "map.landmarks"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "terrains"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "terrains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "x-unit": "refs",
            "x-ref": "map.terrain",
            "description": "Terrains it can stand on."
          }
        }
      }
    }
  }
}
