{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack.names",
  "title": "pack.names",
  "description": "What the setting calls each thing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "pack.names"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ref",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "ref": {
            "type": "string",
            "x-unit": "ref",
            "x-ref": "*",
            "description": "sheet:id of the thing named."
          },
          "name": {
            "type": "string",
            "x-unit": "text"
          },
          "plural": {
            "type": "string",
            "x-unit": "text"
          }
        }
      }
    }
  }
}
