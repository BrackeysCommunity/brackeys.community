{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growth.xp-by-deed",
  "title": "growth.xp-by-deed",
  "description": "Experience for each deed that matters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sheet", "rows"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "growth.xp-by-deed"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "xp"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "xp": {
            "type": "integer",
            "minimum": 0,
            "x-unit": "xp"
          }
        }
      }
    }
  }
}
