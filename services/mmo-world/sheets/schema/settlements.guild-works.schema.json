{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "settlements.guild-works",
  "title": "settlements.guild-works",
  "description": "What each guild work consumes and gives (GDD 4.14).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "settlements.guild-works"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "uses",
          "gives",
          "by"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quantity"
              ],
              "properties": {
                "tag": {
                  "type": "string",
                  "x-unit": "tag",
                  "x-ref": "tags.vocabulary",
                  "description": "Any material with this tag counts; empty for coin."
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "x-unit": "goods",
                  "description": "Goods, or coin when the tag is empty."
                }
              }
            },
            "x-unit": "parts",
            "description": "Consumed from the bank each world day; coin from the treasury."
          },
          "gives": {
            "type": "string",
            "enum": [
              "station-fee",
              "threat",
              "rest",
              "raid-defence",
              "market-fee",
              "mount-upkeep"
            ],
            "x-unit": "enum"
          },
          "by": {
            "type": "integer",
            "x-unit": "count",
            "description": "How much it gives: per cent off a station fee or upkeep, threat a day, rest ticks, percentage points off the market fee."
          },
          "needs": {
            "type": "string",
            "x-unit": "ref",
            "x-ref": "settlements.structures",
            "description": "A structure the settlement must hold."
          },
          "waits": {
            "type": "string",
            "x-unit": "text",
            "description": "The milestone whose system reads what it gives, if not yet built."
          }
        }
      }
    }
  }
}
