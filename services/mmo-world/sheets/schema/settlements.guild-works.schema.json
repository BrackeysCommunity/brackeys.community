{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "settlements.guild-works",
  "title": "settlements.guild-works",
  "description": "What each guild work consumes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sheet", "rows"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "settlements.guild-works"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "material", "perDay"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "material": {
            "type": "string",
            "x-unit": "ref",
            "x-ref": "items.materials"
          },
          "perDay": {
            "type": "integer",
            "minimum": 0,
            "x-unit": "goods"
          }
        }
      }
    }
  }
}
