{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story.caches",
  "title": "story.caches",
  "description": "Goods a solved pattern or a won side opens.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "story.caches"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "goods"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "goods": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "material",
                "quantity"
              ],
              "properties": {
                "material": {
                  "type": "string",
                  "x-unit": "ref",
                  "x-ref": "items.materials"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "x-unit": "goods"
                }
              }
            },
            "x-unit": "parts"
          },
          "note": {
            "type": "string",
            "x-unit": "text"
          }
        }
      }
    }
  }
}
