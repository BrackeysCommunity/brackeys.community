{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classes.classes",
  "title": "classes.classes",
  "description": "Classes and what unlocks them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "classes.classes"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "unlockDeed",
          "unlockAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "unlockDeed": {
            "type": "string",
            "x-unit": "ref",
            "x-ref": "growth.xp-by-deed"
          },
          "unlockAt": {
            "type": "integer",
            "minimum": 1,
            "x-unit": "count"
          }
        }
      }
    }
  }
}
