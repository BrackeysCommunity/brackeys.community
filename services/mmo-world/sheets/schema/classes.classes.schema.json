{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classes.classes",
  "title": "classes.classes",
  "description": "Classes and what unlocks them (GDD 5.8).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "classes.classes"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "unlock",
          "skill",
          "tag",
          "leans"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "unlock": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id",
                "at"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "practice",
                    "deed",
                    "crafts"
                  ],
                  "x-unit": "enum"
                },
                "id": {
                  "type": "string",
                  "x-unit": "text",
                  "description": "The practice skill, deed or process."
                },
                "at": {
                  "type": "integer",
                  "minimum": 1,
                  "x-unit": "count"
                }
              }
            },
            "x-unit": "parts"
          },
          "skill": {
            "type": "string",
            "x-unit": "text",
            "description": "The practice whose level raises the class level."
          },
          "tag": {
            "type": "string",
            "x-unit": "tag",
            "x-ref": "tags.vocabulary",
            "description": "The tag the class gives the character."
          },
          "leans": {
            "type": "string",
            "x-unit": "text"
          }
        }
      }
    }
  }
}
