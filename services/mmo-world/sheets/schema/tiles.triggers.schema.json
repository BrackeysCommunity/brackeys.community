{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiles.triggers",
  "title": "tiles.triggers",
  "description": "What tile and character data set off, with chances and magnitudes (GDD 8.6).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "tiles.triggers"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "on",
          "chance",
          "magnitude",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "on": {
            "type": "string",
            "enum": [
              "arrive",
              "explore",
              "gather",
              "meet"
            ],
            "x-unit": "enum"
          },
          "chance": {
            "type": "number",
            "multipleOf": 0.0001,
            "minimum": 0,
            "maximum": 1,
            "x-unit": "chance"
          },
          "magnitude": {
            "type": "integer",
            "x-unit": "row",
            "description": "In the unit named by the unit column."
          },
          "unit": {
            "type": "string",
            "enum": [
              "coin",
              "goods",
              "pts",
              "durability",
              "xp",
              "level",
              "tier",
              "load",
              "health",
              "defence",
              "gauge",
              "standing",
              "event-points",
              "ticks",
              "days",
              "percent",
              "ratio",
              "count",
              "tiles",
              "weight",
              "chance",
              "band-steps",
              "beat",
              "seconds",
              "degrees"
            ],
            "x-unit": "enum"
          },
          "window": {
            "type": "integer",
            "minimum": 0,
            "x-unit": "ticks",
            "description": "How far back what it reads may lie."
          },
          "tag": {
            "type": "string",
            "x-unit": "tag",
            "x-ref": "tags.vocabulary",
            "description": "The tag it sets, for a rule to read."
          },
          "doc": {
            "type": "string",
            "x-unit": "text"
          }
        }
      }
    }
  }
}
