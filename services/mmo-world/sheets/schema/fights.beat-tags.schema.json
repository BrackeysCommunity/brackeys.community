{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fights.beat-tags",
  "title": "fights.beat-tags",
  "description": "How a site's and a creature's tags choose its beats.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "fights.beat-tags"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tag",
          "beat",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "tag": {
            "type": "string",
            "x-unit": "tag",
            "x-ref": "tags.vocabulary"
          },
          "beat": {
            "type": "string",
            "x-unit": "ref",
            "x-ref": "fights.beats"
          },
          "weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "x-unit": "weight"
          }
        }
      }
    }
  }
}
