{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "items.traits",
  "title": "items.traits",
  "description": "Traits and the tag each gives.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "items.traits"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tag",
          "favours"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "tag": {
            "type": "string",
            "x-unit": "tag",
            "x-ref": "tags.vocabulary"
          },
          "favours": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "x-unit": "text",
            "description": "Record keys (event:tag) that make a milestone offer this trait; the busiest key wins."
          },
          "strong": {
            "type": "boolean",
            "x-unit": "flag",
            "description": "Inscribe's deep method draws only strong traits, its shallow method only the rest."
          }
        }
      }
    }
  }
}
