{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "puzzles.titles",
  "title": "puzzles.titles",
  "description": "The title each family's masters hold.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "puzzles.titles"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id",
            "description": "The family's id."
          },
          "family": {
            "type": "string",
            "x-unit": "ref",
            "x-ref": "puzzles.families"
          }
        }
      }
    }
  }
}
