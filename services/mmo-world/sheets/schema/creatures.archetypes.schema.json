{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creatures.archetypes",
  "title": "creatures.archetypes",
  "description": "Creature archetypes: tier, biomes, tags, drops.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "creatures.archetypes"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tier",
          "biomes",
          "tags",
          "drops"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "x-unit": "tier"
          },
          "biomes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "x-unit": "refs",
            "x-ref": "map.terrain"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "x-unit": "tags",
            "x-ref": "tags.vocabulary"
          },
          "drops": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "x-unit": "refs",
            "x-ref": "items.materials"
          }
        }
      }
    }
  }
}
