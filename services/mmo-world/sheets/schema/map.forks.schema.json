{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map.forks",
  "title": "map.forks",
  "description": "The ways down from a fork, and the tags each adds to the floor below (GDD 4.9).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "map.forks"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kinds",
          "tags",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "x-unit": "refs",
            "x-ref": "map.dungeons",
            "description": "The dungeon kinds whose forks offer it."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "x-unit": "tags",
            "x-ref": "tags.vocabulary",
            "description": "One to three tags the floor it leads to gains."
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "x-unit": "weight",
            "description": "How often it is drawn against the kind's other ways."
          },
          "note": {
            "type": "string",
            "x-unit": "text"
          }
        }
      }
    }
  }
}
