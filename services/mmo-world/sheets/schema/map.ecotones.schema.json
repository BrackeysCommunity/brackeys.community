{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map.ecotones",
  "title": "map.ecotones",
  "description": "What the fade between two land biomes holds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "map.ecotones"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "biomeA",
          "biomeB",
          "tag"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "biomeA": {
            "type": "string",
            "x-unit": "ref",
            "x-ref": "map.biomes"
          },
          "biomeB": {
            "type": "string",
            "x-unit": "ref",
            "x-ref": "map.biomes"
          },
          "tag": {
            "type": "string",
            "x-unit": "tag",
            "x-ref": "tags.vocabulary"
          },
          "materialTags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "x-unit": "tags",
            "x-ref": "tags.vocabulary"
          },
          "note": {
            "type": "string",
            "x-unit": "text"
          }
        }
      }
    }
  }
}
