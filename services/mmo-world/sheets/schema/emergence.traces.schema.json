{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emergence.traces",
  "title": "emergence.traces",
  "description": "GDD 13.1's traces, what each is counted on and how fast it fades.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "emergence.traces"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decayPercent",
          "on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "passage",
              "clearing",
              "loss",
              "working",
              "haulage",
              "reliance",
              "renown",
              "mastery"
            ],
            "x-unit": "enum"
          },
          "decayPercent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "x-unit": "percent",
            "description": "Lost a world day."
          },
          "on": {
            "type": "string",
            "enum": [
              "tile",
              "site",
              "node",
              "pair",
              "region",
              "subject",
              "settlement"
            ],
            "x-unit": "enum",
            "description": "What one trace is counted on."
          },
          "note": {
            "type": "string",
            "x-unit": "text"
          }
        }
      }
    }
  }
}
