{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emergence.traces",
  "title": "emergence.traces",
  "description": "Trace decay and promotion lines.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sheet", "rows"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "emergence.traces"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decayPercent", "promoteAt"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "decayPercent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "x-unit": "percent"
          },
          "promoteAt": {
            "type": "integer",
            "minimum": 1,
            "x-unit": "count"
          }
        }
      }
    }
  }
}
