{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fights.hunts",
  "title": "fights.hunts",
  "description": "Hunts: a creature's health pool, window and spoils.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "fights.hunts"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "creature",
          "healthRatio",
          "windowDays",
          "spoils"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "creature": {
            "type": "string",
            "x-unit": "ref",
            "x-ref": "creatures.archetypes"
          },
          "healthRatio": {
            "type": "number",
            "multipleOf": 0.0001,
            "minimum": 0,
            "x-unit": "ratio",
            "description": "Times the tier's hunt health."
          },
          "windowDays": {
            "type": "integer",
            "minimum": 1,
            "x-unit": "days",
            "description": "A guardian's window opens at the first press."
          },
          "spoils": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "material",
                "quantity"
              ],
              "properties": {
                "material": {
                  "type": "string",
                  "x-unit": "ref",
                  "x-ref": "items.materials"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "x-unit": "goods"
                }
              }
            },
            "x-unit": "goods",
            "description": "The most each line rolls at the kill; it rolls half to all."
          },
          "kind": {
            "type": "string",
            "x-unit": "ref",
            "x-ref": "map.dungeons",
            "description": "A guardian: the dungeon kind whose bottom it guards, on that kind's tags. Empty: a hunt in the world."
          },
          "spawnChance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "x-unit": "percent",
            "description": "The chance, each world day, that it opens in an awake region where its creature stands at spawnLine; 0 opens only when called."
          },
          "spawnLine": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "x-unit": "percent",
            "description": "The creature's population there, as a share of capacity."
          },
          "marks": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "x-unit": "percent",
            "description": "Shares of the pool, falling: the first time it falls to or below each, a machine stands on the beat."
          },
          "family": {
            "type": "string",
            "x-unit": "ref",
            "x-ref": "puzzles.families",
            "description": "The family a mark's machine is, played as its party version."
          }
        }
      }
    }
  }
}
