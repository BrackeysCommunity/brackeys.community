{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fights.beats",
  "title": "fights.beats",
  "description": "The nine kinds of beat.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "fights.beats"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "modifier",
          "haul"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "modifier": {
            "type": "integer",
            "x-unit": "pts",
            "description": "Added to the creature tier's base difficulty."
          },
          "haul": {
            "type": "integer",
            "minimum": 0,
            "x-unit": "goods",
            "description": "Units of the creature's drops a won beat yields."
          },
          "puzzle": {
            "type": "boolean",
            "x-unit": "flag",
            "description": "Resolved by a machine puzzle, not a roll."
          },
          "health": {
            "type": "integer",
            "minimum": 0,
            "x-unit": "percent",
            "description": "guardian: its pool, as a share of the tier's hunt health."
          },
          "ends": {
            "type": "boolean",
            "x-unit": "flag",
            "description": "A failure here ends the encounter without a loss (the quarry escapes)."
          },
          "note": {
            "type": "string",
            "x-unit": "text"
          }
        }
      }
    }
  }
}
