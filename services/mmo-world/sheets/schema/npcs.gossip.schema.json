{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "npcs.gossip",
  "title": "npcs.gossip",
  "description": "How a neighbour's memory is passed on, by its kind (GDD 4.18).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "npcs.gossip"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "line"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id",
            "description": "The kind of memory entry it voices."
          },
          "line": {
            "type": "string",
            "x-unit": "text",
            "description": "The templated line: {neighbour}, {who}, {thing} and {n} come from the entry."
          }
        }
      }
    }
  }
}
