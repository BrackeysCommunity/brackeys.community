{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack.palette",
  "title": "pack.palette",
  "description": "Banner colours and the tags that favour them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "pack.palette"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tags",
          "hex"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "x-unit": "tags",
            "x-ref": "tags.vocabulary"
          },
          "hex": {
            "type": "string",
            "x-unit": "text",
            "description": "#rrggbb"
          }
        }
      }
    }
  }
}
