{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "items.materials",
  "title": "items.materials",
  "description": "Base materials and their authored vectors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "items.materials"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tier",
          "tags",
          "vector"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "x-unit": "tier"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "x-unit": "tags",
            "x-ref": "tags.vocabulary"
          },
          "vector": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "edge",
              "weight",
              "flex",
              "conduct",
              "heat",
              "ward",
              "reach",
              "bond"
            ],
            "properties": {
              "edge": {
                "type": "integer",
                "minimum": 0,
                "x-unit": "pts"
              },
              "weight": {
                "type": "integer",
                "minimum": 0,
                "x-unit": "pts"
              },
              "flex": {
                "type": "integer",
                "minimum": 0,
                "x-unit": "pts"
              },
              "conduct": {
                "type": "integer",
                "minimum": 0,
                "x-unit": "pts"
              },
              "heat": {
                "type": "integer",
                "minimum": 0,
                "x-unit": "pts"
              },
              "ward": {
                "type": "integer",
                "minimum": 0,
                "x-unit": "pts"
              },
              "reach": {
                "type": "integer",
                "minimum": 0,
                "x-unit": "pts"
              },
              "bond": {
                "type": "integer",
                "minimum": 0,
                "x-unit": "pts"
              }
            },
            "x-unit": "pts"
          }
        }
      }
    }
  }
}
