{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emergence.legend-traits",
  "title": "emergence.legend-traits",
  "description": "The traits a legend may carry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "emergence.legend-traits"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tag"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "tag": {
            "type": "string",
            "x-unit": "tag",
            "x-ref": "tags.vocabulary"
          },
          "note": {
            "type": "string",
            "x-unit": "text"
          }
        }
      }
    }
  }
}
