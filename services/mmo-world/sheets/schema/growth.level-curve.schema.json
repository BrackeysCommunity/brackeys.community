{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growth.level-curve",
  "title": "growth.level-curve",
  "description": "Derived from growth.params; never edited by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "growth.level-curve"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "level",
          "xpToNext",
          "xpSoFar"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "x-unit": "level"
          },
          "xpToNext": {
            "type": "integer",
            "minimum": 0,
            "x-unit": "xp"
          },
          "xpSoFar": {
            "type": "integer",
            "minimum": 0,
            "x-unit": "xp"
          },
          "milestone": {
            "type": "boolean",
            "x-unit": "flag"
          }
        }
      }
    }
  }
}
