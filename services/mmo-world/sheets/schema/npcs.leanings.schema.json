{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "npcs.leanings",
  "title": "npcs.leanings",
  "description": "The odds an NPC leans upright or crooked, by its home's faction or its role (GDD 4.18).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sheet": {
      "const": "npcs.leanings"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "upright",
          "crooked"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "x-unit": "id",
            "description": "A factions.archetypes id, a role's leaning, or none."
          },
          "upright": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "x-unit": "percent"
          },
          "crooked": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "x-unit": "percent"
          },
          "note": {
            "type": "string",
            "x-unit": "text"
          }
        }
      }
    }
  }
}
