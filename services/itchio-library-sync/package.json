{
  "name": "@brackeys/itchio-library-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Railway cron job that re-syncs every linked itch.io account's game library into the main brackeys Postgres DB.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.20.0",
    "posthog-node": "^5.49.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.14"
}
