# Postgres connection string — the same DB the main brackeys app uses.
DATABASE_URL=postgres://user:pass@host:5432/brackeys

# Redis — the same instance the web app and the crawler enqueue into. Holds
# the media-scan queue and the per-host itch pacer shared with the crawler.
REDIS_URL=redis://localhost:6379

# The private uploads bucket (same trio the web app has). Without these the
# worker still scans covers and banners; upload jobs are skipped with a warning.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

USER_AGENT=brackeys-media-scan/0.1 (+https://brackeys.community)

# Per-host pacing, shared pool-wide through Redis. itch.io covers data.json;
# img.itch.zone is the cover CDN.
MIN_REQUEST_INTERVAL_MS=350
IMAGE_MIN_REQUEST_INTERVAL_MS=150
RATE_LIMIT_COOLDOWN_MS=60000

# Jobs processed at once. Inference is CPU-bound and fetches ride the shared
# pacer, so more only overlaps the two.
SCAN_CONCURRENCY=3

# How much the hourly reconciler enqueues per run — the throttle a detector
# bump drains at. Revisits (cover drift, plan 24) have their own budget so
# they never starve first-time scans.
SCAN_BATCH=1500
SCAN_REVISIT_BATCH=300
SCAN_REVISIT_DAYS=90
SCAN_REVISIT_INTERVAL_DAYS=7
BANNER_BATCH=500
UPLOAD_BATCH=500

# Minimum probe probability that opens a flag, and the (higher) point at
# which an upload is hidden pending review. Set the latter above 1 to make
# uploads flag-only, like entries.
NSFW_THRESHOLD=0.99
UPLOAD_QUARANTINE_THRESHOLD=0.99
NSFW_ENABLED=true
