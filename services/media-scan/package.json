    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.0",
    "bullmq": "^5.34.0",
    "drizzle-orm": "1.0.0-rc.4",
    "ioredis": "^5.4.2",
    "minio": "^8.0.0",
    "pg": "^8.20.0",
    "posthog-node": "^5.49.1",
    "sharp": "^0.34.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.14",
