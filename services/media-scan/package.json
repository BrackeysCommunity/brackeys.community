{
  "name": "@brackeys/media-scan",
  "version": "0.1.0",
  "private": true,
  "description": "Resident Railway worker that fingerprints and scores every image the platform shows — scraped covers and banners, and member uploads — from one BullMQ queue.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "reconcile": "bun run src/jobs/reconcile.ts",
