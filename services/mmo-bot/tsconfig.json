{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "../../packages/discord-kit/src/**/*.ts",
    "../../packages/mmo-api/src/**/*.ts",
    "../../packages/mmo-words/src/**/*.ts",
    "../../packages/mmo-narrate/src/**/*.ts"
  ]
}
