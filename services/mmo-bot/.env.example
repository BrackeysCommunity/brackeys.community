# The bot's environment, every name src/config.ts reads. Copy to .env.local
# (gitignored) for `bun run local` and `bun run register`; a deploy sets the
# same names in its own environment. Nothing here holds a value: secrets
# never go in this file or in the repository.

# Secret. The bot user's token (Developer Portal, the app's Bot page).
DISCORD_TOKEN=
# The application id (Developer Portal, General Information). Not secret.
DISCORD_APP_ID=
# The primary server's id. Required with MMO_COMMANDS=guild; optional with global.
DISCORD_GUILD_ID=
# Comma-separated server ids the guild-scoped commands go to; the primary server alone when empty.
MMO_GUILD_IDS=
# guild (the default, for test servers) or global (for launch).
MMO_COMMANDS=
# The world service's address; http://localhost:8080 when empty.
MMO_WORLD_URL=
# Secret. The world's player-path token. One token only, even while the world accepts "new,old".
MMO_API_TOKEN=
# Secret when it carries a password. Redis for cooldowns, poster marks, party threads and narration; no channel posts without it.
REDIS_URL=
# The threat line routes stop before, a whole number; the world's ambush line when empty.
MMO_THREAT_LINE=
# The market forum channel, by id or name, where a server's settings map none.
MMO_MARKET_FORUM=
# The notice-board forum channel, by id or name, where a server's settings map none.
MMO_GOALS_FORUM=
# The game channel the hunt cards go to when no events channel is set, by id or name.
MMO_GAME_CHANNEL=
# The events channel, by id or name, where a server's settings map none.
MMO_EVENTS_CHANNEL=
# The chronicle channel, by id or name, where a server's settings map none.
MMO_CHRONICLE_CHANNEL=
# The log channel, by id or name, where a server's settings map none.
MMO_LOG_CHANNEL=
# The alarm role a raid's start mentions where a server's settings name none.
MMO_EVENTS_ALARM_ROLE=
# Milliseconds between lexicon reads, a whole number; five minutes when empty.
LEXICON_REFRESH_MS=
# Secret. The model's key; narration needs it, MMO_NARRATION=on and REDIS_URL.
ANTHROPIC_API_KEY=
# on turns narration's master switch on; anything else leaves every card its template.
MMO_NARRATION=
# The world-wide narration budget a world day, in dollars; 1 when empty.
MMO_NARRATION_DAY_USD=
