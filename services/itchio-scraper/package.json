{
  "name": "@brackeys/itchio-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Railway cron job that scrapes itch.io jam data and syncs it into the main brackeys Postgres DB.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "live": "bun run src/jobs/sync-live.ts",
    "discover": "bun run src/jobs/discover.ts",
    "results": "bun run src/jobs/collect-results.ts",
    "start": "bun run src/index.ts",
    "backfill": "bun run src/jobs/backfill-history.ts",
    "drain": "bun run src/jobs/drain-results.ts",
    "resync": "bun run src/jobs/resync-stale.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.14"
}
