{
  "name": "@brackeys/itchio-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Railway cron services that scrape itch.io jam data and sync it into the main brackeys Postgres DB.",
  "type": "module",
  "scripts": {
    "live": "bun run src/jobs/sync-live.ts",
    "discover": "bun run src/jobs/discover.ts",
    "results": "bun run src/jobs/collect-results.ts",
    "backfill": "bun run src/jobs/backfill-history.ts",
    "sweep": "bun run src/jobs/sweep-ids.ts",
    "scan": "bun run src/jobs/scan.ts",
    "drain": "bun run src/jobs/drain-results.ts",
    "resync": "bun run src/jobs/resync-stale.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.20.0",
    "posthog-node": "^5.49.1",
    "sharp": "^0.34.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "onnxruntime-node",
    "protobufjs",
    "sharp"
  ]
}
