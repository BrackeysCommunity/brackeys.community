# Postgres connection string — the same DB the main brackeys app uses.
DATABASE_URL=postgres://user:pass@host:5432/brackeys

# When to scrape the per-entry rate page (which carries per-criterion ranks).
#   always        — every run
#   after-voting  — only when jam.status === "over" (default)
#   never         — skip entirely
SCRAPE_ENTRY_RESULTS=after-voting

# Throttling for rate-page scrape.
ENTRY_RESULTS_CONCURRENCY=3
ENTRY_RESULTS_DELAY_MS=500

# Global pacing across ALL itch.io requests (shared by every worker): minimum
# gap between any two requests, and how long the whole pool pauses after a
# 429/503 when itch doesn't send Retry-After.
MIN_REQUEST_INTERVAL_MS=350
RATE_LIMIT_COOLDOWN_MS=60000

# How long a jam whose page 404s keeps being retried before it drops out of
# the resync bucket. Nothing is ever deleted — after this window the row sits
# with missing_since set, awaiting manual verification.
MISSING_RETRY_DAYS=3

# How many days back the /jams/past walk looks for jams that ended while the
# scraper wasn't running. Should comfortably exceed the longest plausible gap
# between successful runs.
ENDED_LOOKBACK_DAYS=14

USER_AGENT=brackeys-itchio-scraper/0.1 (+https://brackeys.community)

# ── Cron tiers ───────────────────────────────────────────────────────────────
# The scrape runs as three independent Railway cron services. All three read
# the same variables, so a shared variable group works — each only uses its own
# section. Defaults are the shipped values; none of these need to be set.
#
# The DEADLINE knobs are what keep the tiers from overlapping: the itch.io rate
# pacer is per-process, so two services running at once double the request rate
# itch sees. Stopping early is always free — every tier resumes from persisted
# progress on the next tick.

# LIVE (hourly, :00) — open jams. The only perishable work.
LIVE_DELAY_MS=250
LIVE_DEADLINE_MINS=45

# DISCOVERY (hourly, :20) — listing walks, new jams, upcoming refresh.
# DISCOVERY_UPCOMING_LIMIT is a per-tick cap; the upcoming pool round-robins
# staleest-first, so raising it refreshes the pool faster, not more completely.
DISCOVERY_DELAY_MS=250
DISCOVERY_DEADLINE_MINS=45
DISCOVERY_UPCOMING_LIMIT=25

# RESULTS (6-hourly, :40) — ranking collection for finished jams.
# "newest" puts the rankings users are most likely to look at first; "smallest"
# clears the backlog count fastest.
RESULTS_DELAY_MS=250
RESULTS_DEADLINE_MINS=240
RESULTS_ORDER=newest
