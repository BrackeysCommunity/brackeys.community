# Postgres connection string — the same DB the main brackeys app uses.
DATABASE_URL=postgres://user:pass@host:5432/brackeys

# Redis — the same instance the web app and media-scan use. With it, the itch
# pacer is shared pool-wide and every new entry / changed cover / changed
# banner becomes a media-scan job. Without it the crawler paces itself and the
# worker's hourly reconciler finds the same work in the DB.
REDIS_URL=redis://localhost:6379

# Seals linked_accounts.access_token at rest — must equal the Web service's.
LINKED_ACCOUNTS_ENC_KEY=

# When to scrape the per-entry rate page (which carries per-criterion ranks).
#   always        — every run
#   after-voting  — only when jam.status === "over" (default)
#   never         — skip entirely
SCRAPE_ENTRY_RESULTS=after-voting

# Throttling for rate-page scrape.
ENTRY_RESULTS_CONCURRENCY=3
ENTRY_RESULTS_DELAY_MS=500

# Per-host pacing (shared through Redis when set): minimum gap between any two
# requests to itch.io / img.itch.zone / api.itch.io, and the base cooldown
# after a 429/503 when itch doesn't send Retry-After.
MIN_REQUEST_INTERVAL_MS=350
IMAGE_MIN_REQUEST_INTERVAL_MS=150
API_MIN_REQUEST_INTERVAL_MS=500
RATE_LIMIT_COOLDOWN_MS=60000

# How long a jam whose page 404s keeps being retried before it drops out of
# every tier's selector. Nothing is ever deleted — after this window the row
# sits with missing_since set, awaiting manual verification.
MISSING_RETRY_DAYS=3

# How many days back the /jams/past walk looks for jams that ended while the
# crawler wasn't running. Should comfortably exceed the longest plausible gap
# between successful runs.
ENDED_LOOKBACK_DAYS=14

USER_AGENT=brackeys-itchio-scraper/0.1 (+https://brackeys.community)

# ── Tier loop ────────────────────────────────────────────────────────────────
# One resident process runs every tier from a priority loop. Each turn runs
# under CRAWLER_CHUNK_MINS; a tier that stops at the chunk resumes on a later
# turn unless something more urgent is due. Intervals are measured from a
# tier *completing* its list.
CRAWLER_CHUNK_MINS=10
LIVE_INTERVAL_MINS=15
JAM_BACKFILL_INTERVAL_MINS=15
DISCOVERY_INTERVAL_MINS=240
RESULTS_INTERVAL_MINS=360
LIBRARY_INTERVAL_MINS=60
SWEEP_INTERVAL_MINS=360

# LIVE — open jams. The only perishable work.
LIVE_DELAY_MS=250
# DISCOVERY — listing walks, new jams, upcoming refresh.
DISCOVERY_DELAY_MS=250
DISCOVERY_UPCOMING_LIMIT=50
# RESULTS — ranking collection for finished jams. "newest" puts the rankings
# users are most likely to look at first; "smallest" clears the backlog
# count fastest.
RESULTS_DELAY_MS=250
RESULTS_ORDER=newest
# LIBRARY — linked itch accounts: pause between accounts on the API pass, and
# how long a game page's "Submission to <jam>" scan stays good for.
SYNC_DELAY_MS=500
JAM_SCAN_MAX_AGE_DAYS=30

# The *_DEADLINE_MINS knobs bound the one-shot dev entrypoints only
# (`bun run live`, `bun run results`, `bun run sweep`).
LIVE_DEADLINE_MINS=45
DISCOVERY_DEADLINE_MINS=25
RESULTS_DEADLINE_MINS=240
SWEEP_DEADLINE_MINS=45
